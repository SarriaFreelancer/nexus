datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceRole {
  ADMIN
  MANAGER
  DEVELOPER
  DESIGNER
  QA
  COMMERCIAL
  CLIENT
  GUEST
}

enum ProjectStatus {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  TESTING
  DEPLOYED
  MAINTENANCE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionPlan {
  FREE
  BASIC
  INTERMEDIATE
  PREMIUM
}

enum TaskStatus {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  TESTING
  DEPLOYED
  MAINTENANCE
  PAUSED
  COMPLETED
  ARCHIVED
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  username      String?           @unique
  password      String?
  name          String
  avatarUrl     String?
  globalRole    GlobalRole        @default(USER)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  memberships   WorkspaceMember[]
  tasksAssigned Task[]            @relation("TaskAssignee")
  timeEntries   TimeEntry[]
  auditLogs     AuditLog[]
  projectEvents ProjectEvent[]
  notifications Notification[]
  preferences   Json?             @default("{}")
  aiAudits      AiAudit[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  logoUrl           String?
  subscriptionPlan  SubscriptionPlan  @default(FREE)
  maxWorkspaces     Int               @default(2)
  maxProjects       Int               @default(3)
  maxCollaborators  Int               @default(5)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members     WorkspaceMember[]
  clients     Client[]
  projects    Project[]
  servers     ServerInstance[]
  financials  FinancialRecord[]
  taskStatuses TaskStatusConfig[]
}

model WorkspaceMember {
  id                String        @id @default(uuid())
  workspaceId       String
  userId            String
  role              WorkspaceRole @default(DEVELOPER)
  allowedProjectIds Json?         @default("[]")
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Client {
  id          String    @id @default(uuid())
  workspaceId String
  company     String
  contactName String
  email       String
  phone       String?
  stage       String    @default("LEAD")
  projects    Project[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Project {
  id             String           @id @default(uuid())
  workspaceId    String
  clientId       String?
  name           String
  code           String
  description    String?          @db.Text
  status         ProjectStatus    @default(DISCOVERY)
  priority       Priority         @default(MEDIUM)
  category       String
  technologies   Json
  gitRepoUrl     String?
  gitToken       String?
  serverDomain   String?
  bannerUrl      String?
  isStarred      Boolean          @default(false)
  estimatedHours Float?
  actualHours    Float            @default(0)
  startDate      DateTime?
  endDate        DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client         Client?          @relation(fields: [clientId], references: [id])
  versions       ProjectVersion[]
  tasks          Task[]
  docs           Document[]
  servers        ServerInstance[]
  projectEvents  ProjectEvent[]
  automations    ProjectAutomation[]
  aiAudits       AiAudit[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectAutomation {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  trigger     String   // "TASK_STATUS_CHANGED", "NEW_VERSION"
  condition   Json?    // e.g. { "from": "DEVELOPMENT", "to": "TESTING" }
  action      String   // "SEND_NOTIFICATION", "CHANGE_PROJECT_STATUS"
  actionData  Json?    // e.g. { "message": "..." }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  version     String
  title       String
  changelog   String   @db.Text
  releaseDate DateTime
  isCurrent   Boolean  @default(false)
  branch      String?  // Git branch name (e.g., main, develop)
  commitHash  String?  // Commit SHA associated with this version
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

}

model Task {
  id          String          @id @default(uuid())
  projectId   String
  versionId   String?
  title       String
  description String?         @db.Text
  status      String          @default("PENDING")
  priority    Priority        @default(MEDIUM)
  assigneeId  String?
  estimatedHs Float?
  loggedHs     Float           @default(0)
  dueDate     DateTime?
  endDate     DateTime?
  coverUrl    String?         @db.Text
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     ProjectVersion? @relation(fields: [versionId], references: [id])
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  subtasks    Subtask[]
  attachments TaskAttachment[]
  timeEntries TimeEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  name      String
  url       String   @db.Text
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskStatusConfig {
  id          String    @id @default(uuid())
  workspaceId String
  key         String
  name        String
  color       String    @default("border-indigo-500")
  position    Int       @default(0)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subtask {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  hours     Float
  note      String?
  date      DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  title     String
  content   String   @db.LongText
  category  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServerInstance {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  name        String
  ipAddress   String
  provider    String
  cpuUsage    Float     @default(0)
  ramUsage    Float     @default(0)
  diskUsage   Float     @default(0)
  status      String    @default("ONLINE")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id])
  updatedAt   DateTime  @updatedAt
}

model FinancialRecord {
  id          String    @id @default(uuid())
  workspaceId String
  type        String
  amount      Float
  category    String
  description String?
  date        DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  details   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ProjectEvent {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  type        String   // "STATUS_CHANGE", "COMMENT", "MEMBER_ADDED", "FILE_UPLOADED", "MILESTONE"
  content     String?  @db.Text
  details     Json?
  createdAt   DateTime @default(now())
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model AiAudit {
  id              String   @id @default(uuid())
  projectId       String
  userId          String
  provider        String   // "groq", "openai", "gemini", "deepseek", "claude"
  model           String   // "llama-3.3-70b-versatile", "gpt-4o", etc.
  status          String   @default("RUNNING") // RUNNING, COMPLETED, FAILED
  score           Int?     // 0-100 maintainability index
  summary         Json?      // Summary counts
  result          String?    @db.LongText // Full AI response JSON string
  contextSnapshot String?    @db.LongText // Context sent to AI as JSON string
  tokensInput     Int?
  tokensOutput    Int?
  durationMs      Int?
  error           String?  @db.Text
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])
}
